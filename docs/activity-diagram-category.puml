@startuml
start
:Admin/Staff truy cập quản lý danh mục;

partition "Danh sách danh mục" {
  :Gửi GET /api/categories?page=&sort=;
  :Hiển thị bảng danh sách
  (ID, Tên, Mô tả, Người tạo, Ngày tạo);

  while (Thao tác?) is (Xem/Tìm)
    if (Tìm kiếm?) then (Có)
      :Gửi GET /api/categories/_search?query=;
      :Hiển thị kết quả tìm kiếm phân trang;
    elseif (Xem chi tiết?) then (Có)
      break
    elseif (Thêm mới?) then (Có)
      break
    elseif (Sửa?) then (Có)
      break
    elseif (Xóa?) then (Có)
      break
    endif
  endwhile
}

if (Luồng xử lý?) is (Xem chi tiết)
  partition "Xem chi tiết danh mục" {
    :Gửi GET /api/categories/{id};
    :Hiển thị thông tin danh mục
    (ID, Tên, Mô tả,
     Người tạo, Ngày tạo,
     Người sửa, Ngày sửa);
  }

elseif (Thêm mới)
  partition "Thêm danh mục mới" {
    :Hiển thị form trống;
    :Nhập tên danh mục
    (bắt buộc, tối đa 50 ký tự);
    :Nhập mô tả
    (không bắt buộc, tối đa 100 ký tự);
    :Validate form;
    if (Dữ liệu hợp lệ?) then (Không)
      :Hiển thị lỗi validation;
      stop
    endif
    :Gửi POST /api/categories;
    partition "Backend" {
      :Map DTO -> Entity;
      :Gán audit fields
      (createdBy, createdDate);
      :Lưu vào DB;
      :Index lên Elasticsearch;
      :Trả về 201 Created + CategoryDTO;
    }
    :Hiển thị thông báo thành công;
    :Quay lại danh sách;
  }

elseif (Cập nhật)
  partition "Chỉnh sửa danh mục" {
    :Gửi GET /api/categories/{id};
    :Hiển thị form với dữ liệu hiện tại;
    :Chỉnh sửa tên / mô tả;
    :Validate form;
    if (Dữ liệu hợp lệ?) then (Không)
      :Hiển thị lỗi validation;
      stop
    endif
    :Gửi PUT /api/categories/{id};
    partition "Backend" {
      :Map DTO -> Entity;
      :Set isPersisted flag;
      :Cập nhật DB;
      :Cập nhật Elasticsearch index;
      :Trả về 200 OK + CategoryDTO;
    }
    :Hiển thị thông báo thành công;
    :Quay lại danh sách;
  }

elseif (Xóa)
  partition "Xóa danh mục" {
    :Mở dialog xác nhận xóa;
    if (Xác nhận xóa?) then (Không)
      :Đóng dialog;
      stop
    endif
    :Gửi DELETE /api/categories/{id};
    partition "Backend" {
      :Xóa khỏi DB;
      :Xóa khỏi Elasticsearch index;
      :Trả về 204 No Content;
    }
    :Hiển thị thông báo thành công;
    :Reload danh sách;
  }

endif

stop
@enduml
