@startuml
|Keycloak (Identity Provider)|
start
:Admin đăng nhập vào
Keycloak Admin Console;
:http://localhost:9080/admin/master/console/;

partition "Quản lý người dùng trong Keycloak" {
  while (Chọn chức năng?) is (Thao tác)
    if (Tạo người dùng mới?) then (Có)
      :Vào menu Users -> Add user;
      :Nhập thông tin
      (Username, Email, First Name,
       Last Name, Email verified);
      :Lưu thông tin cơ bản;
      :Vào tab Credentials;
      :Đặt mật khẩu
      (Temporary / Permanent);
      :Lưu mật khẩu;
    elseif (Gán roles?) then (Có)
      :Chọn người dùng;
      :Vào tab Role mapping;
      :Chọn realm roles
      (ROLE_ADMIN, ROLE_USER);
      :Assign / Unassign roles;
    elseif (Sửa thông tin?) then (Có)
      :Chọn người dùng;
      :Cập nhật thông tin
      (Email, Name, Avatar);
      :Lưu thay đổi;
    elseif (Vô hiệu hóa?) then (Có)
      :Chọn người dùng;
      :Vào tab Settings;
      :Tắt User Enabled;
      :Lưu;
    elseif (Xóa người dùng?) then (Có)
      :Chọn người dùng;
      :Delete user;
      :Xác nhận xóa;
    endif
  endwhile
}

|Ứng dụng Mono Ecom|

partition "Luồng đồng bộ người dùng" {
  :Người dùng truy cập ứng dụng;
  :Chuyển hướng đến Keycloak đăng nhập;
  :Nhập username / password;

  if (Xác thực thành công?) then (Không)
    :Hiển thị lỗi trên Keycloak form;
    stop
  endif

  :Keycloak tạo JWT
  chứa claims (sub, preferred_username,
  email, roles, picture, locale...);
  :Redirect về ứng dụng với
  authorization code -> đổi lấy token;

  :Frontend gọi GET /api/account;
  :Backend nhận AbstractAuthenticationToken;

  partition "UserService.getUserFromAuthentication()" {
    :Giải mã claims từ JWT / OAuth2 token;
    :Tạo đối tượng User từ claims
    (id = sub, login = preferred_username,
     firstName = given_name,
     lastName = family_name,
     email, activated = email_verified,
     langKey, imageUrl = picture);
    :Map GrantedAuthority
    -> Set<Authority>;

    :Gọi syncUserWithIdP();
    partition "syncUserWithIdP()" {
      :Lấy danh sách Authority từ DB;
      forEach (Authority từ JWT)
        if (Chưa tồn tại trong DB?) then (Có)
          :Lưu Authority mới vào DB;
        endif
      end

      :Tìm User theo login trong DB;
      if (User đã tồn tại?) then (Có)
        :So sánh updated_at
        giữa IdP và DB;
        if (IdP mới hơn?) then (Có)
          :Cập nhật thông tin User
          (firstName, lastName, email...);
        endif
      else (Chưa có)
        :Lưu User mới vào
        bảng jhi_user + join authorities;
      endif
    }
  }

  :Trả về AdminUserDTO cho frontend;
  :Hiển thị thông tin người dùng
  (avatar, tên, roles);

  note right
    Lần đầu đăng nhập: User
    được tự động tạo trong DB local
    Lần sau: Chỉ update nếu
    IdP có thay đổi
  end note
}

partition "Đăng xuất" {
  :Người dùng nhấn Logout;
  :Frontend gọi POST /api/logout;
  :Backend tạo logout URL
  (end_session_endpoint +
   id_token_hint +
   post_logout_redirect_uri);
  :Trả về logoutUrl;
  :Chuyển hướng trình duyệt
  đến Keycloak logout;
  :Keycloak kết thúc session;
  :Redirect về ứng dụng;
}

|Keycloak|

partition "Quản lý roles & scopes" {
  :Admin vào menu Realm Roles;
  :Tạo / sửa / xóa realm roles
  (ROLE_ADMIN, ROLE_USER);
  :Gán composite roles nếu cần;

  note right
    Khi user login lần sau,
    roles mới được sync
    xuống bảng jhi_authority
    + jhi_user_authority
    tự động qua
    syncUserWithIdP()
  end note
}

stop
@enduml
